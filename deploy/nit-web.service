# Staff console and webhooks. Installed by deploy/bootstrap.sh.
[Unit]
Description=NIT Hospital Automation - web
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=nit
Group=nit
WorkingDirectory=/opt/nit-hospital-automation
EnvironmentFile=/opt/nit-hospital-automation/.env
Environment=NODE_ENV=production
# Bound to localhost: Caddy is the only thing that talks to the internet.
ExecStart=/opt/nit-hospital-automation/node_modules/.bin/next start -H 127.0.0.1 -p 3000
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/nit-hospital-automation/.next
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nit-web

[Install]
WantedBy=multi-user.target
