# Background worker: classification, messaging, reminders, no-show sweep, retention.
# Installed by deploy/bootstrap.sh.
[Unit]
Description=NIT Hospital Automation - worker
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=nit
Group=nit
WorkingDirectory=/opt/nit-hospital-automation
EnvironmentFile=/opt/nit-hospital-automation/.env
Environment=NODE_ENV=production
ExecStart=/opt/nit-hospital-automation/node_modules/.bin/tsx src/worker/index.ts
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nit-worker

[Install]
WantedBy=multi-user.target
