{
  "name": "nit-hospital-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/migrate.ts --reset && tsx scripts/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "dev:all": "concurrently -k -n web,worker -c cyan,magenta \"next dev\" \"tsx watch src/worker/index.ts\"",
    "db:demo": "tsx scripts/demo-data.ts",
    "db:demo:clinic": "tsx scripts/demo-clinic.ts",
    "db:demo:care": "tsx scripts/demo-care.ts",
    "retention": "tsx scripts/retention.ts",
    "preflight": "tsx scripts/preflight.ts",
    "templates": "tsx scripts/register-templates.ts",
    "user:create": "tsx scripts/user.ts create",
    "user:list": "tsx scripts/user.ts list",
    "user:demo": "tsx scripts/demo-users.ts",
    "user:reset": "tsx scripts/user.ts reset",
    "user:deactivate": "tsx scripts/user.ts deactivate"
  },
  "dependencies": {
    "dotenv": "^18.0.1",
    "next": "^16.3.5",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
