# HTTPS with an automatic certificate. deploy/bootstrap.sh writes this for you with the real
# domain; this copy is the template for doing it by hand.
#
# Caddy terminates TLS and forwards to the app on localhost, so the app itself never handles
# certificates and is never exposed directly. Webhooks verify their own signature or secret
# in the application, so they need no special handling here.

care.example.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
