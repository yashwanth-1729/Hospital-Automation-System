# --- Database ---
DATABASE_URL=postgresql://nit_app:nit_dev_only@localhost:5432/nit_hospital
TEST_DATABASE_URL=postgresql://nit_app:nit_dev_only@localhost:5432/nit_hospital_test

# --- Hospital identity (shown in patient messages) ---
HOSPITAL_NAME=DemoCare Multispeciality Hospital
HOSPITAL_CONTACT=+91 80000 00000
EMERGENCY_NUMBER=108

# --- AI ---
# rules  = deterministic keyword classifier (no API key needed)
# openai_compatible = any OpenAI-compatible API: OpenRouter, DeepSeek, OpenAI, Groq, local Ollama...
AI_PROVIDER=rules
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=anthropic/claude-haiku-4.5
AI_TIMEOUT_MS=20000

# --- Messaging ---
# mock = messages appear in the dashboard's Demo Phone (no WhatsApp account needed)
# whatsapp_cloud = Meta WhatsApp Cloud API
MESSAGING_PROVIDER=mock
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_API_VERSION=v23.0
WA_TEMPLATE_LANGUAGE=en

# --- Security ---
# If set, POST /api/webhooks/lead requires header  x-webhook-secret: <value>
WEBHOOK_SECRET=
# If set, the staff dashboard requires HTTP basic auth (user: admin)
DASHBOARD_PASSWORD=

# --- Docker only: password for the bundled Postgres container ---
POSTGRES_PASSWORD=change-me
