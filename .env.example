# --- Database ---
DATABASE_URL=postgresql://nit_app:nit_dev_only@localhost:5432/nit_hospital
TEST_DATABASE_URL=postgresql://nit_app:nit_dev_only@localhost:5432/nit_hospital_test

# --- Hospital identity (shown in patient messages) ---
HOSPITAL_NAME=DemoCare Multispeciality Hospital
HOSPITAL_CONTACT=+91 80000 00000
EMERGENCY_NUMBER=108

# --- AI ---
# rules  = deterministic keyword classifier (no API key needed)
# openai_compatible = any OpenAI-compatible API: OpenRouter, DeepSeek, OpenAI, Groq, local Ollama...
AI_PROVIDER=rules
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=deepseek/deepseek-v4-flash
AI_TIMEOUT_MS=20000

# --- Messaging ---
# mock = messages appear in the dashboard's Demo Phone (no WhatsApp account needed)
# whatsapp_cloud = Meta WhatsApp Cloud API
MESSAGING_PROVIDER=mock
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_API_VERSION=v23.0
WA_TEMPLATE_LANGUAGE=en

# --- No-show recovery ---
# Automatically mark an appointment as a no-show this many minutes after it ended.
NO_SHOW_AUTO_DETECT=true
NO_SHOW_GRACE_MINUTES=60
# Wait before sending the reschedule message (set 0 for live demos).
NO_SHOW_RECOVERY_DELAY_MINUTES=30
# Hours to wait for a response before the next attempt / staff escalation.
NO_SHOW_FOLLOWUP_HOURS=24
NO_SHOW_MAX_ATTEMPTS=2

# --- Discharge follow-up & feedback ---
# Hours after discharge before the feedback request is sent (set 0 for live demos).
FEEDBACK_DELAY_HOURS=48
FEEDBACK_LINK_VALID_DAYS=30
FOLLOWUP_REMINDER_HOUR=10
# Used to build the patient feedback link.
PUBLIC_BASE_URL=http://localhost:3000

# --- Inbound WhatsApp (delivery receipts and patient replies) ---
# From the Meta app: Settings -> Basic -> App Secret.
WA_APP_SECRET=
# A string you invent; Meta echoes it back once when the webhook is registered.
WA_VERIFY_TOKEN=

# --- Retention (DPDP Act 2023) ---
RETENTION_ENABLED=true
RETENTION_MESSAGE_DAYS=180
RETENTION_ENQUIRY_DAYS=365

# --- Security ---
# If set, POST /api/webhooks/lead requires header  x-webhook-secret: <value>
WEBHOOK_SECRET=
# Staff sign in with their own accounts; there is no shared password. Create the first
# administrator with:  npm run user:create -- --role admin --name "Your Name" --email you@example.com

# --- Docker only: password for the bundled Postgres container ---
POSTGRES_PASSWORD=change-me

# WhatsApp Business Account id, used only to submit templates: npm run templates -- --submit
WA_BUSINESS_ACCOUNT_ID=
